UNI_API_URL=https://uni-api-ember.fugue.pro
ANALYTICS_TIMEZONE=Asia/Shanghai
SOURCE_ID=uni-api-console
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=<project-object-store-bucket>
S3_PREFIX=uni-api-facts/v1/
INGEST_TOKEN=replace-with-a-random-internal-token
ADMIN_TOKEN=replace-with-a-random-admin-token
AWS_ACCESS_KEY_ID=<scoped-read-access-key>
AWS_SECRET_ACCESS_KEY=<scoped-read-secret>
AWS_REGION=auto
