{
  "manifest_version": 3,
  "name": "uni-api 登录助手",
  "version": "1.3.0",
  "description": "在你授权的 sub2api / New API 站点完成登录，并将会话交回 uni-api 控制台。",
  "permissions": ["scripting"],
  "optional_permissions": ["cookies"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "gecko": {
      "id": "uni-api-browser-helper@yym68686.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://uni-api-console.fugue.pro/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "uni-api 登录助手",
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://*/*"]
}
